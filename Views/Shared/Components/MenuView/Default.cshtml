@model IList<tblMenu>

<ul>
    @foreach (var menu in Model.Where(m => m.Levels == 1).OrderBy(m => m.MenuOrder))
    {
        var pID = menu.MenuID;
        var sMenu = Model.Where(s => s.ParentID == pID).OrderBy(s => s.MenuOrder).ToList();
        if (sMenu.Count == 0)
        {
            <li><a href="#">@menu.MenuName</a></li>
        }
        else
        {
            <li><a href="#">@menu.MenuName</a>
                <ul class="sub-menu">
                    @foreach (var smn in sMenu)
                    {
                        <li><a href="#">@smn.MenuName</a></li>
                    }
                </ul>
            </li>
        }
    }
</ul>